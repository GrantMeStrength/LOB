<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DatabaseAccess.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DatabaseAccess"
    xmlns:models="using:DatabaseAccess.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="TaskTemplate" x:DataType="models:TaskItem">
            <ItemContainer HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Bind Title, Mode=OneWay}">
                <Grid Padding="12" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox
                        Grid.Column="0"
                        MinWidth="0"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="TaskCompleteCheckBox"
                        AutomationProperties.Name="Mark task complete"
                        IsChecked="{x:Bind IsComplete, Mode=TwoWay}" />

                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Title, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />

                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind local:MainPage.FormatDueDate(DueDate), Mode=OneWay}" />
                </Grid>
            </ItemContainer>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="Task tracker" />

        <!--  New task form  -->
        <Grid
            Grid.Row="1"
            Padding="16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            ColumnSpacing="12"
            CornerRadius="{StaticResource ControlCornerRadius}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                Grid.Column="0"
                VerticalAlignment="Bottom"
                AutomationProperties.AutomationId="NewTaskTitleTextBox"
                Header="Title"
                PlaceholderText="What needs doing?"
                Text="{x:Bind ViewModel.NewTaskTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <DatePicker
                Grid.Column="1"
                VerticalAlignment="Bottom"
                AutomationProperties.AutomationId="NewTaskDatePicker"
                Date="{x:Bind ViewModel.NewTaskDueDate, Mode=TwoWay}"
                Header="Due date" />

            <Button
                Grid.Column="2"
                VerticalAlignment="Bottom"
                AutomationProperties.AutomationId="AddTaskButton"
                Command="{x:Bind ViewModel.AddTaskCommand}"
                Content="New task"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>

        <!--
            Persistence failures are contextual and recoverable, so an inline
            InfoBar keeps the task list visible and offers a direct retry path.
        -->
        <InfoBar
            Grid.Row="2"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasOperationError, Mode=OneWay}"
            Message="{x:Bind ViewModel.OperationError, Mode=OneWay}"
            Severity="Error"
            Title="Local database error">
            <InfoBar.ActionButton>
                <Button
                    AutomationProperties.AutomationId="RetryDatabaseButton"
                    Command="{x:Bind ViewModel.InitializeCommand}"
                    Content="Retry" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!--  Task list  -->
        <Grid Grid.Row="3">
            <ItemsView
                AutomationProperties.AutomationId="TasksItemsView"
                AutomationProperties.Name="Tasks"
                ItemTemplate="{StaticResource TaskTemplate}"
                ItemsSource="{x:Bind ViewModel.Tasks, Mode=OneWay}"
                SelectionMode="None"
                Visibility="{x:Bind local:MainPage.InvertBoolToVisibility(ViewModel.IsEmpty), Mode=OneWay}" />

            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="No tasks yet. Add one above to get started."
                Visibility="{x:Bind local:MainPage.BoolToVisibility(ViewModel.IsEmpty), Mode=OneWay}" />

            <!-- Pair progress with text so loading is not communicated by motion alone. -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="{x:Bind local:MainPage.BoolToVisibility(ViewModel.IsBusy), Mode=OneWay}">
                <ProgressRing
                    Width="32"
                    Height="32"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Updating tasks…" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
