<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="DashboardAndDailyTasks.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <StaticResource x:Key="AppCardBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
                    <StaticResource x:Key="AppCardBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
                    <Thickness x:Key="AppCardBorderThickness">1</Thickness>
                    <Thickness x:Key="CardSurfaceBorderThickness">1</Thickness>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <StaticResource x:Key="AppCardBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
                    <StaticResource x:Key="AppCardBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
                    <Thickness x:Key="AppCardBorderThickness">1</Thickness>
                    <Thickness x:Key="CardSurfaceBorderThickness">1</Thickness>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="AppCardBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="AppCardBorderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <Thickness x:Key="AppCardBorderThickness">2</Thickness>
                    <Thickness x:Key="CardSurfaceBorderThickness">2</Thickness>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AppCardBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="{ThemeResource AppCardBorderThickness}" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
                <Setter Property="Padding" Value="20" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
