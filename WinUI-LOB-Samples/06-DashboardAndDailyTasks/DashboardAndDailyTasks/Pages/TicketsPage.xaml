<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DashboardAndDailyTasks.Pages.TicketsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DashboardAndDailyTasks.Controls"
    xmlns:local="using:DashboardAndDailyTasks.Pages"
    xmlns:models="using:DashboardAndDailyTasks.Models">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <StaticResource x:Key="TicketSelectionBackplateBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="TicketSelectionIndicatorBrush" ResourceKey="AccentFillColorDefaultBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <StaticResource x:Key="TicketSelectionBackplateBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="TicketSelectionIndicatorBrush" ResourceKey="AccentFillColorDefaultBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="TicketSelectionBackplateBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="TicketSelectionIndicatorBrush" ResourceKey="SystemColorButtonTextColorBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style x:Key="WorkspaceCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="{ThemeResource CardSurfaceBorderThickness}" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            </Style>
            <Style x:Key="EyebrowTextStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="WrapWholeWords" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>
    <ScrollViewer
        x:Name="PageScrollViewer"
        HorizontalScrollBarVisibility="Disabled"
        VerticalContentAlignment="Stretch"
        VerticalScrollBarVisibility="Disabled"
        VerticalScrollMode="Disabled">
        <Grid
            x:Name="PageLayout"
            Padding="24"
            RowSpacing="16"
            SizeChanged="PageLayout_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="WorkspaceLayoutRow" Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <TextBlock AutomationProperties.HeadingLevel="Level1" Style="{StaticResource TitleTextBlockStyle}" Text="Tickets" />
        </Grid>
        <InfoBar
            x:Name="ModelUnavailableBanner"
            Grid.Row="1"
            IsClosable="True"
            IsOpen="True"
            Message="Ticket analysis requires a compatible on-device model."
            Severity="Warning"
            Title="No AI model available">
            <InfoBar.ActionButton>
                <HyperlinkButton Click="OpenAiSettings_Click" Content="Choose a model in Settings" />
            </InfoBar.ActionButton>
        </InfoBar>
        <Grid x:Name="WorkspaceGrid" Grid.Row="2" ColumnSpacing="16" RowSpacing="16">
            <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="QueueColumn" Width="*" />
            <ColumnDefinition x:Name="DetailColumn" Width="2*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="QueueRow" Height="*" />
                <RowDefinition x:Name="DetailRow" Height="0" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource WorkspaceCardStyle}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock
                            x:Name="QueueEmptyState"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            AutomationProperties.LiveSetting="Polite"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="No open tickets"
                            Visibility="Collapsed" />
                        <ItemsView
                            x:Name="TicketsList"
                            Padding="8"
                            AutomationProperties.AutomationId="SupportTicketsList"
                            IsItemInvokedEnabled="True"
                            ItemInvoked="TicketList_ItemInvoked"
                            SelectionMode="None">
                            <ItemsView.Layout>
                                <StackLayout Spacing="4" />
                            </ItemsView.Layout>
                            <ItemsView.ItemTemplate>
                                <DataTemplate x:DataType="models:SupportTicket">
                                    <ItemContainer
                                        HorizontalContentAlignment="Stretch"
                                        AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}">
                                        <Grid>
                                            <Border
                                                Background="{ThemeResource TicketSelectionBackplateBrush}"
                                                CornerRadius="{StaticResource ControlCornerRadius}"
                                                Visibility="{x:Bind local:TicketsPage.BoolToVisibility(IsSelected), Mode=OneWay}" />
                                            <Border
                                                Width="4"
                                                Margin="0,12"
                                                HorizontalAlignment="Left"
                                                Background="{ThemeResource TicketSelectionIndicatorBrush}"
                                                CornerRadius="{StaticResource ControlCornerRadius}"
                                                Visibility="{x:Bind local:TicketsPage.BoolToVisibility(IsSelected), Mode=OneWay}" />
                                            <Grid MinHeight="76" Padding="12" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="1" MinWidth="72" Padding="8,4" VerticalAlignment="Center" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="{StaticResource ControlCornerRadius}">
                                                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}">
                                                        <Run Text="#" />
                                                        <Run Text="{x:Bind Id, Mode=OneWay}" />
                                                    </TextBlock>
                                                </Border>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                                                    <TextBlock MaxLines="2" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Subject, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="WrapWholeWords" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        TextTrimming="CharacterEllipsis">
                                                        <Run Text="{x:Bind Customer, Mode=OneWay}" />
                                                        <Run Text="  ·  " />
                                                        <Run Text="{x:Bind Product, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <Border Grid.Column="3" Padding="8,4" VerticalAlignment="Center" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="{StaticResource ControlCornerRadius}">
                                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind StatusLabel, Mode=OneWay}" />
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </ItemContainer>
                                </DataTemplate>
                            </ItemsView.ItemTemplate>
                        </ItemsView>
                    </Grid>
                    <Button
                        x:Name="ToggleDoneButton"
                        Grid.Row="1"
                        Margin="12"
                        HorizontalAlignment="Stretch"
                        Click="ToggleDone_Click"
                        Content="Show completed tickets" />
                </Grid>
            </Border>
            <ScrollViewer
                x:Name="DetailScrollViewer"
                Grid.Column="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalContentAlignment="Stretch"
                VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Border x:Name="EmptyDetailPanel" MinHeight="400" Padding="40" Style="{StaticResource WorkspaceCardStyle}">
                        <StackPanel MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="No open tickets" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Ticket details will be shown here when a ticket is selected." TextAlignment="Center" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>
                    <Border
                        x:Name="DetailPanel"
                        Padding="20"
                        Style="{StaticResource WorkspaceCardStyle}"
                        Visibility="Collapsed">
                        <StackPanel Spacing="20">
                            <StackPanel Spacing="16">
                                <Grid x:Name="TicketHeaderGrid" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition x:Name="TicketHeaderActionsColumn" Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition x:Name="TicketHeaderActionsRow" Height="0" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Spacing="8">
                                        <Border HorizontalAlignment="Left" Padding="8,4" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="{StaticResource ControlCornerRadius}">
                                            <TextBlock x:Name="TicketNumberText" Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Border>
                                        <TextBlock x:Name="TicketSubjectText" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                    <StackPanel
                                        x:Name="TicketHeaderActions"
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        Spacing="8">
                                        <SplitButton
                                            x:Name="TicketStatusButton"
                                            HorizontalAlignment="Right"
                                            AutomationProperties.Name="Change ticket status"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            Click="StatusPrimary_Click"
                                            CornerRadius="{StaticResource ControlCornerRadius}">
                                            <SplitButton.Flyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Click="MarkPending_Click" Text="Pending" />
                                                    <MenuFlyoutItem Click="MarkInProgress_Click" Text="In progress" />
                                                    <MenuFlyoutItem Click="MarkDone_Click" Text="Done" />
                                                </MenuFlyout>
                                            </SplitButton.Flyout>
                                            <TextBlock x:Name="TicketStatusText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        </SplitButton>
                                        <Button
                                            x:Name="TriageButton"
                                            HorizontalAlignment="Right"
                                            AutomationProperties.AutomationId="AnalyzeTicketButton"
                                            AutomationProperties.Name="Analyze selected ticket locally"
                                            Click="Triage_Click"
                                            Style="{StaticResource AccentButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <ProgressRing
                                                    x:Name="TriageProgress"
                                                    Width="16"
                                                    Height="16"
                                                    AutomationProperties.Name="Analyzing selected ticket" />
                                                <TextBlock Text="Analyze locally" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <Grid x:Name="TicketMetadataGrid" ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition x:Name="TicketProductColumn" Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition x:Name="TicketProductRow" Height="0" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="CUSTOMER" />
                                        <TextBlock x:Name="TicketCustomerText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    </StackPanel>
                                    <StackPanel x:Name="TicketProductPanel" Grid.Column="1" Spacing="4">
                                        <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="PRODUCT" />
                                        <TextBlock x:Name="TicketProductText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    </StackPanel>
                                </Grid>
                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="CUSTOMER DESCRIPTION" />
                                    <TextBlock x:Name="TicketDescriptionText" TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </StackPanel>
                        <Border
                            x:Name="TriageResult"
                            Padding="20"
                            AutomationProperties.AccessibilityView="Content"
                            AutomationProperties.LiveSetting="Polite"
                            Background="{ThemeResource AccentFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource AccentControlElevationBorderBrush}"
                            BorderThickness="{ThemeResource CardSurfaceBorderThickness}"
                            CornerRadius="{StaticResource OverlayCornerRadius}"
                            Visibility="Collapsed">
                            <StackPanel Spacing="16">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="16" Glyph="&#xE945;" />
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Local intelligence" />
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Generated privately on this device" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" Padding="8,4" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" CornerRadius="{StaticResource ControlCornerRadius}">
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Local only" />
                                    </Border>
                                </Grid>
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="SUGGESTED CATEGORY" />
                                        <Border Padding="12,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="{StaticResource ControlCornerRadius}">
                                            <TextBlock x:Name="TicketCategoryText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="SUMMARY" />
                                        <TextBlock x:Name="TicketSummaryText" TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <StackPanel Spacing="12">
                            <TextBlock AutomationProperties.HeadingLevel="Level3" Style="{StaticResource SubtitleTextBlockStyle}" Text="Discussion" />
                            <Border Padding="16" Style="{StaticResource WorkspaceCardStyle}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="32"
                                        Height="32"
                                        VerticalAlignment="Top"
                                        AutomationProperties.AccessibilityView="Raw"
                                        Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                        CornerRadius="16">
                                        <FontIcon FontSize="16" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Glyph="&#xE77B;" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="8">
                                        <AutoSuggestBox
                                            x:Name="NewCommentBox"
                                            AutomationProperties.Name="Add a comment"
                                            PlaceholderText="Add a comment"
                                            QuerySubmitted="NewComment_QuerySubmitted"
                                            SuggestionChosen="NewComment_SuggestionChosen"
                                            TextChanged="NewComment_TextChanged"
                                            UpdateTextOnSelect="False">
                                            <AutoSuggestBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:TaskLinkOption">
                                                    <Grid
                                                        Padding="8,4"
                                                        ColumnSpacing="12"
                                                        Tag="{x:Bind}"
                                                        Tapped="CommentSuggestion_Tapped">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="72" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Kind, Mode=OneTime}" />
                                                        <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneTime}" TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </DataTemplate>
                                            </AutoSuggestBox.ItemTemplate>
                                        </AutoSuggestBox>
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="Type @ to link a customer or ticket." />
                                        <Button HorizontalAlignment="Right" Click="AddComment_Click" Content="Comment" Style="{StaticResource AccentButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ItemsControl x:Name="CommentsList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="12" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:TicketComment">
                                        <Border Padding="16" Style="{StaticResource WorkspaceCardStyle}">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    Width="32"
                                                    Height="32"
                                                    VerticalAlignment="Top"
                                                    AutomationProperties.AccessibilityView="Raw"
                                                    Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                                    CornerRadius="16">
                                                    <FontIcon FontSize="16" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Glyph="&#xE77B;" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="12">
                                                    <Grid ColumnSpacing="4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Author, Mode=OneTime}" />
                                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="commented" />
                                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind CreatedLabel, Mode=OneTime}" />
                                                    </Grid>
                                                    <ItemsControl ItemsSource="{x:Bind InlineParts, Mode=OneTime}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <controls:InlineWrapPanel HorizontalSpacing="4" VerticalSpacing="4" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="models:InlineContentPart">
                                                                <Grid MinHeight="32">
                                                                    <TextBlock VerticalAlignment="Center" Text="{x:Bind Text, Mode=OneTime}" Visibility="{x:Bind TextVisibility, Mode=OneTime}" />
                                                                    <Button
                                                                        Padding="8,4"
                                                                        AutomationProperties.Name="{x:Bind LinkDisplayName, Mode=OneTime}"
                                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                                        Click="OpenCommentLink_Click"
                                                                        Content="{x:Bind LinkText, Mode=OneTime}"
                                                                        CornerRadius="12"
                                                                        Tag="{x:Bind Link, Mode=OneTime}"
                                                                        Visibility="{x:Bind LinkVisibility, Mode=OneTime}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
        </Grid>
    </ScrollViewer>
</Page>
