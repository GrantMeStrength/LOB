<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DashboardAndDailyTasks.Pages.TasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DashboardAndDailyTasks.Controls"
    xmlns:models="using:DashboardAndDailyTasks.Models">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock AutomationProperties.HeadingLevel="Level1" Style="{StaticResource TitleTextBlockStyle}" Text="Tasks" />

        <Border Grid.Row="1" Padding="16" Style="{StaticResource CardStyle}">
            <Grid ColumnSpacing="12" RowSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="New task" />
                <TextBlock Grid.Column="1" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Due date" />
                <AutoSuggestBox
                    x:Name="NewTaskTitle"
                    Grid.Row="1"
                    AutomationProperties.AutomationId="NewTaskTitle"
                    AutomationProperties.Name="New task"
                    PlaceholderText="Describe the task"
                    QuerySubmitted="NewTaskTitle_QuerySubmitted"
                    SuggestionChosen="NewTaskTitle_SuggestionChosen"
                    TextChanged="NewTaskTitle_TextChanged"
                    UpdateTextOnSelect="False">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="models:TaskLinkOption">
                            <Grid
                                Padding="8,4"
                                ColumnSpacing="12"
                                Tag="{x:Bind}"
                                Tapped="TaskSuggestion_Tapped">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Kind, Mode=OneTime}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{x:Bind Name, Mode=OneTime}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
                <CalendarDatePicker
                    x:Name="DueDatePicker"
                    Grid.Row="1"
                    Grid.Column="1"
                    MinWidth="160"
                    AutomationProperties.Name="Due date"
                    DateFormat="month day" />
                <Button
                    Grid.Row="1"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Click="AddTask_Click"
                    Content="Add task"
                    Style="{StaticResource AccentButtonStyle}" />
                <TextBlock
                    Grid.Row="2"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Type @ to attach one or more customers or tickets." />
                <InfoBar
                    x:Name="TaskInfoBar"
                    Grid.Row="3"
                    Grid.ColumnSpan="3"
                    AutomationProperties.LiveSetting="Assertive"
                    IsClosable="True"
                    Severity="Error" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <SelectorBar
                    x:Name="TaskFilter"
                    AutomationProperties.Name="Task status"
                    SelectionChanged="TaskFilter_SelectionChanged">
                    <SelectorBarItem x:Name="OpenFilterItem" Text="Open" />
                    <SelectorBarItem x:Name="CompletedFilterItem" Text="Completed" />
                    <SelectorBarItem x:Name="DeletedFilterItem" Text="Deleted" />
                </SelectorBar>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <TextBlock VerticalAlignment="Center" Text="Sort by" />
                    <ComboBox
                        x:Name="TaskSortComboBox"
                        MinWidth="200"
                        AutomationProperties.Name="Sort tasks"
                        SelectionChanged="TaskSortComboBox_SelectionChanged">
                        <x:String>Manual order</x:String>
                        <x:String>Due date (earliest first)</x:String>
                        <x:String>Due date (latest first)</x:String>
                        <x:String>Customers first</x:String>
                        <x:String>Tickets first</x:String>
                        <x:String>Attachments first</x:String>
                        <x:String>No attachments first</x:String>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <TextBlock
                    x:Name="EmptyStateText"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="No open tasks." />
                <ListView
                    x:Name="TaskList"
                    AllowDrop="True"
                    AutomationProperties.AutomationId="TaskList"
                    CanDragItems="False"
                    CanReorderItems="True"
                    DragItemsCompleted="TaskList_DragItemsCompleted"
                    DragItemsStarting="TaskList_DragItemsStarting"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:WorkTask">
                            <Border
                                Margin="0,0,0,8"
                                Padding="12"
                                PointerEntered="TaskItem_PointerEntered"
                                PointerExited="TaskItem_PointerExited"
                                Style="{StaticResource CardStyle}">
                                <Grid
                                    HorizontalAlignment="Stretch"
                                    Background="Transparent"
                                    ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <controls:MoveCursorGrid
                                        Width="24"
                                        Height="40"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        AutomationProperties.HelpText="Use the Up and Down arrow keys to reorder"
                                        AutomationProperties.Name="{x:Bind ReorderAutomationName, Mode=OneWay}"
                                        GotFocus="DragHandle_GotFocus"
                                        KeyDown="DragHandle_KeyDown"
                                        LostFocus="DragHandle_LostFocus"
                                        Opacity="0"
                                        PointerEntered="DragHandle_PointerEntered"
                                        PointerExited="DragHandle_PointerExited"
                                        PointerPressed="DragHandle_PointerPressed"
                                        PointerReleased="DragHandle_PointerReleased"
                                        ToolTipService.ToolTip="Drag to reorder, or use the Up and Down arrow keys">
                                        <FontIcon
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xE700;" />
                                    </controls:MoveCursorGrid>
                                    <CheckBox
                                        Grid.Column="1"
                                        Width="20"
                                        MinWidth="20"
                                        Padding="0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                                        Click="CompleteTask_Click"
                                        IsEnabled="{x:Bind IsNotDeleted, Mode=OneWay}"
                                        IsChecked="{x:Bind IsComplete, Mode=TwoWay}" />
                                    <ItemsControl Grid.Column="2" VerticalAlignment="Center" ItemsSource="{x:Bind InlineParts, Mode=OneTime}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <controls:InlineWrapPanel HorizontalSpacing="4" VerticalSpacing="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:InlineContentPart">
                                                <Grid MinHeight="32">
                                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Text, Mode=OneTime}" Visibility="{x:Bind TextVisibility, Mode=OneTime}" />
                                                    <Button
                                                        Padding="8,4"
                                                        AutomationProperties.Name="{x:Bind LinkDisplayName, Mode=OneTime}"
                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                        Click="OpenRelatedRecord_Click"
                                                        Content="{x:Bind LinkText, Mode=OneTime}"
                                                        CornerRadius="12"
                                                        Tag="{x:Bind Link, Mode=OneTime}"
                                                        Visibility="{x:Bind LinkVisibility, Mode=OneTime}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Grid.Column="3" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Due" />
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind DueValue, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="4"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="{x:Bind DeleteAutomationName, Mode=OneWay}"
                                        Click="RemoveTask_Click"
                                        GotFocus="TaskDeleteButton_GotFocus"
                                        LostFocus="TaskDeleteButton_LostFocus"
                                        Opacity="0"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="Delete task"
                                        Visibility="{x:Bind IsNotDeleted, Mode=OneWay}">
                                        <SymbolIcon Symbol="Delete" />
                                    </Button>
                                    <Button
                                        Grid.Column="4"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="{x:Bind RestoreAutomationName, Mode=OneWay}"
                                        Click="RestoreTask_Click"
                                        GotFocus="TaskDeleteButton_GotFocus"
                                        LostFocus="TaskDeleteButton_LostFocus"
                                        Opacity="0"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="Restore task"
                                        Visibility="{x:Bind IsDeleted, Mode=OneWay}">
                                        <FontIcon Glyph="&#xE777;" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Page>
