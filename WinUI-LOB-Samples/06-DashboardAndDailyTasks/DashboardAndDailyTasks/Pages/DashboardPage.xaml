<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DashboardAndDailyTasks.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:DashboardAndDailyTasks.Controls"
    xmlns:models="using:DashboardAndDailyTasks.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <StaticResource x:Key="DashboardHeroBackgroundBrush" ResourceKey="LayerFillColorAltBrush" />
                    <StaticResource x:Key="DashboardChartLineBrush" ResourceKey="AccentFillColorDefaultBrush" />
                    <StaticResource x:Key="DashboardInteractiveBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
                    <Thickness x:Key="DashboardHeroBorderThickness">1</Thickness>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <StaticResource x:Key="DashboardHeroBackgroundBrush" ResourceKey="LayerFillColorAltBrush" />
                    <StaticResource x:Key="DashboardChartLineBrush" ResourceKey="AccentFillColorDefaultBrush" />
                    <StaticResource x:Key="DashboardInteractiveBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
                    <Thickness x:Key="DashboardHeroBorderThickness">1</Thickness>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="DashboardHeroBackgroundBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="DashboardChartLineBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="DashboardInteractiveBorderBrush" ResourceKey="SystemColorButtonTextColorBrush" />
                    <Thickness x:Key="DashboardHeroBorderThickness">2</Thickness>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

        <CornerRadius x:Key="DashboardBoxCornerRadius">8</CornerRadius>
        <Style x:Key="DashboardCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="{ThemeResource CardSurfaceBorderThickness}" />
            <Setter Property="CornerRadius" Value="{StaticResource DashboardBoxCornerRadius}" />
        </Style>
        <Style
            x:Key="DashboardSectionLabelStyle"
            BasedOn="{StaticResource CaptionTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>
        <DataTemplate x:Key="SummaryCardContentTemplate" x:DataType="models:SummaryCard">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        FontSize="16"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Glyph="{x:Bind Glyph, Mode=OneTime}" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Title, Mode=OneTime}" />
                </Grid>
                <Grid Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock
                        Style="{StaticResource TitleLargeTextBlockStyle}"
                        Text="{x:Bind Value, Mode=OneTime}"
                        Visibility="{x:Bind IsNotCritical, Mode=OneTime}" />
                    <TextBlock
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Style="{StaticResource TitleLargeTextBlockStyle}"
                        Text="{x:Bind Value, Mode=OneTime}"
                        Visibility="{x:Bind IsCritical, Mode=OneTime}" />
                </Grid>
                <TextBlock
                    Grid.Row="2"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Detail, Mode=OneTime}"
                    TextWrapping="WrapWholeWords" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="DashboardTicketTemplate" x:DataType="models:SupportTicket">
            <Button
                MinHeight="64"
                Padding="12"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DashboardInteractiveBorderBrush}"
                Click="DashboardTicket_Click"
                CornerRadius="{StaticResource DashboardBoxCornerRadius}"
                Tag="{x:Bind}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        MinWidth="56"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyStrongTextBlockStyle}">
                        <Run Text="#" />
                        <Run Text="{x:Bind Id, Mode=OneTime}" />
                    </TextBlock>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind Subject, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextTrimming="CharacterEllipsis">
                            <Run Text="{x:Bind Customer, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run Text="{x:Bind Product, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="32,24,24,24" Spacing="20">
            <Grid x:Name="DashboardHeaderGrid" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="DashboardGreetingText"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Good morning, Alex" />
                <TextBlock
                    x:Name="DashboardDateText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Wednesday, August 12" />
            </Grid>

            <Border
                x:Name="RevenueOverviewPanel"
                Padding="16"
                Background="{ThemeResource DashboardHeroBackgroundBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="{ThemeResource DashboardHeroBorderThickness}"
                CornerRadius="{StaticResource DashboardBoxCornerRadius}">
                <Grid x:Name="HeroGrid" ColumnSpacing="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition x:Name="HeroMetricColumn" Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition x:Name="HeroMetricRow" Height="0" />
                    </Grid.RowDefinitions>

                    <StackPanel VerticalAlignment="Center" Spacing="16">
                        <StackPanel Spacing="8">
                            <TextBlock
                                Style="{StaticResource TitleTextBlockStyle}"
                                Text="Your team is on track for a record month."
                                TextWrapping="WrapWholeWords" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Pipeline is up 18% and response time is at its best this quarter. Five priority items need your attention today."
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </StackPanel>

                    <Border
                        x:Name="HeroMetric"
                        Grid.Column="1"
                        Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="{StaticResource DashboardBoxCornerRadius}">
                        <StackPanel Spacing="12">
                            <Grid>
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Style="{StaticResource DashboardSectionLabelStyle}"
                                        Text="MONTHLY RECURRING REVENUE" />
                                    <TextBlock
                                        Style="{StaticResource TitleLargeTextBlockStyle}"
                                        Text="$482.6K" />
                                </StackPanel>
                                <Border
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Padding="8,4"
                                    Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                    CornerRadius="{StaticResource ControlCornerRadius}">
                                    <TextBlock
                                        AutomationProperties.Name="12.4 percent increase"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="↑ 12.4%" />
                                </Border>
                            </Grid>
                            <ProgressBar
                                AutomationProperties.Name="Monthly revenue target, 86 percent"
                                IsHitTestVisible="False"
                                Maximum="100"
                                Value="86" />
                            <Grid>
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="$77.4K to monthly target" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="86%" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup>
                            <VisualState x:Name="WideHero">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="840" />
                                </VisualState.StateTriggers>
                            </VisualState>
                            <VisualState x:Name="NarrowHero">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="0" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="HeroMetricColumn.Width" Value="0" />
                                    <Setter Target="HeroMetricRow.Height" Value="Auto" />
                                    <Setter Target="HeroGrid.ColumnSpacing" Value="0" />
                                    <Setter Target="HeroGrid.RowSpacing" Value="20" />
                                    <Setter Target="HeroMetric.(Grid.Column)" Value="0" />
                                    <Setter Target="HeroMetric.(Grid.Row)" Value="1" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                </Grid>
            </Border>

            <ItemsControl
                x:Name="SummaryCardsPanel"
                AutomationProperties.AutomationId="DashboardCards"
                AutomationProperties.Name="Key performance indicators"
                ItemsSource="{x:Bind ViewModel.Cards, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:ResponsiveUniformGridPanel
                            ColumnSpacing="12"
                            MaximumColumns="5"
                            MinItemWidth="216"
                            RowSpacing="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:SummaryCard">
                        <Border
                            MinHeight="172"
                            Padding="20"
                            AutomationProperties.Name="{x:Bind AutomationName, Mode=OneTime}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="{ThemeResource CardSurfaceBorderThickness}"
                            CornerRadius="{StaticResource DashboardBoxCornerRadius}">
                            <ContentPresenter Content="{x:Bind}" ContentTemplate="{StaticResource SummaryCardContentTemplate}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid x:Name="InsightGrid" ColumnSpacing="16" SizeChanged="WidgetGrid_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="InsightPrimaryColumn" Width="3*" />
                    <ColumnDefinition x:Name="InsightSecondaryColumn" Width="2*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="InsightSecondaryRow" Height="0" />
                </Grid.RowDefinitions>

                <Border
                    x:Name="TicketPerformancePanel"
                    MinHeight="320"
                    Padding="20"
                    Style="{StaticResource DashboardCardStyle}">
                    <StackPanel Spacing="20">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                AutomationProperties.HeadingLevel="Level2"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="Tickets closed this week" />
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                    Text="27 closed" />
                                <TextBlock
                                    AutomationProperties.Name="14 percent increase versus last week"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="↑ 14% vs last week" />
                            </StackPanel>
                        </Grid>

                        <Grid
                            ColumnSpacing="8"
                            AutomationProperties.AccessibilityView="Content"
                            AutomationProperties.Name="Tickets closed by day: Thursday 2, Friday 3, Saturday 3, Sunday 4, Monday 4, Tuesday 5, today 6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="180" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Canvas
                                Width="16"
                                Height="180"
                                AutomationProperties.AccessibilityView="Raw">
                                <TextBlock Canvas.Top="0" Style="{StaticResource CaptionTextBlockStyle}" Text="6" />
                                <TextBlock Canvas.Top="55" Style="{StaticResource CaptionTextBlockStyle}" Text="4" />
                                <TextBlock Canvas.Top="110" Style="{StaticResource CaptionTextBlockStyle}" Text="2" />
                                <TextBlock Canvas.Top="165" Style="{StaticResource CaptionTextBlockStyle}" Text="0" />
                            </Canvas>

                            <Grid Grid.Column="1" Height="180" Margin="8,0">
                                <Grid Margin="0,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" />
                                    <Border Grid.Row="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" />
                                    <Border Grid.Row="2" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,1" />
                                </Grid>
                                <Viewbox Margin="0,8" Stretch="Fill">
                                    <Canvas Width="600" Height="164">
                                        <Path
                                            Data="M 0,109.3 L 100,82 L 200,82 L 300,54.7 L 400,54.7 L 500,27.3 L 600,0"
                                            Stroke="{ThemeResource DashboardChartLineBrush}"
                                            StrokeEndLineCap="Round"
                                            StrokeLineJoin="Round"
                                            StrokeStartLineCap="Round"
                                            StrokeThickness="4" />
                                    </Canvas>
                                </Viewbox>
                            </Grid>

                            <Grid Grid.Row="1" Grid.Column="1" Margin="8,0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock HorizontalAlignment="Center" Style="{StaticResource DashboardSectionLabelStyle}" Text="Thu" />
                                <TextBlock Grid.Column="1" HorizontalAlignment="Center" Style="{StaticResource DashboardSectionLabelStyle}" Text="Fri" />
                                <TextBlock Grid.Column="2" HorizontalAlignment="Center" Style="{StaticResource DashboardSectionLabelStyle}" Text="Sat" />
                                <TextBlock Grid.Column="3" HorizontalAlignment="Center" Style="{StaticResource DashboardSectionLabelStyle}" Text="Sun" />
                                <TextBlock Grid.Column="4" HorizontalAlignment="Center" Style="{StaticResource DashboardSectionLabelStyle}" Text="Mon" />
                                <TextBlock Grid.Column="5" HorizontalAlignment="Center" Style="{StaticResource DashboardSectionLabelStyle}" Text="Tue" />
                                <TextBlock Grid.Column="6" HorizontalAlignment="Center" Style="{StaticResource DashboardSectionLabelStyle}" Text="Today" />
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border
                    x:Name="PriorityPanel"
                    Grid.Column="1"
                    MinHeight="320"
                    Padding="20"
                    Style="{StaticResource DashboardCardStyle}">
                    <StackPanel Spacing="16">
                        <Grid>
                            <TextBlock
                                AutomationProperties.HeadingLevel="Level2"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="Today's tasks" />
                            <Button
                                HorizontalAlignment="Right"
                                Click="OpenOperations_Click"
                                Content="View all tasks"
                                Tag="Priority work" />
                        </Grid>

                        <ItemsControl x:Name="DashboardTasksList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:WorkTask">
                                    <Border MinHeight="72" Padding="12" Style="{StaticResource DashboardCardStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="104" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox
                                                Width="20"
                                                MinWidth="20"
                                                Padding="0"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                                                Click="DashboardTaskComplete_Click"
                                                IsChecked="{x:Bind IsComplete, Mode=TwoWay}" />
                                            <ItemsControl
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                ItemsSource="{x:Bind InlineParts, Mode=OneTime}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <controls:InlineWrapPanel HorizontalSpacing="4" VerticalSpacing="4" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:InlineContentPart">
                                                        <Grid MinHeight="32">
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                                Text="{x:Bind Text, Mode=OneTime}"
                                                                Visibility="{x:Bind TextVisibility, Mode=OneTime}" />
                                                            <Button
                                                                Padding="8,4"
                                                                AutomationProperties.Name="{x:Bind LinkDisplayName, Mode=OneTime}"
                                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                                Click="OpenTaskRelatedRecord_Click"
                                                                CornerRadius="12"
                                                                Tag="{x:Bind Link, Mode=OneTime}"
                                                                ToolTipService.ToolTip="{x:Bind LinkDisplayName, Mode=OneTime}"
                                                                Visibility="{x:Bind LinkVisibility, Mode=OneTime}">
                                                                <Button.Content>
                                                                    <TextBlock
                                                                        MaxWidth="240"
                                                                        Text="{x:Bind LinkText, Mode=OneTime}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                                </Button.Content>
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Due" />
                                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind DueValue, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </Border>

            </Grid>

            <Grid x:Name="MomentumGrid" ColumnSpacing="16" SizeChanged="WidgetGrid_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="MomentumPrimaryColumn" Width="3*" />
                    <ColumnDefinition x:Name="MomentumSecondaryColumn" Width="2*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="MomentumSecondaryRow" Height="0" />
                </Grid.RowDefinitions>

                <Border x:Name="CustomerMomentumPanel" Padding="20" Style="{StaticResource DashboardCardStyle}">
                    <StackPanel Spacing="16">
                        <Grid>
                            <TextBlock
                                AutomationProperties.HeadingLevel="Level2"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="Customers" />
                            <Button
                                HorizontalAlignment="Right"
                                Click="OpenOperations_Click"
                                Content="View all customers"
                                Tag="Account pipeline" />
                        </Grid>

                        <Grid
                            Padding="12"
                            ColumnSpacing="16"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="{StaticResource DashboardBoxCornerRadius}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource DashboardSectionLabelStyle}" Text="ACCOUNT" />
                            <TextBlock Grid.Column="1" Style="{StaticResource DashboardSectionLabelStyle}" Text="STAGE" />
                            <TextBlock Grid.Column="2" Style="{StaticResource DashboardSectionLabelStyle}" Text="VALUE" />
                        </Grid>

                        <Button
                            x:Name="MomentumButton1"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Click="OpenOperations_Click"
                            Tag="Northwind expansion">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="MomentumCompany1" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Northwind Traders" />
                                    <TextBlock
                                        x:Name="MomentumDetail1"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Expansion · Maya Chen" />
                                </StackPanel>
                                <TextBlock x:Name="MomentumStatus1" Grid.Column="1" VerticalAlignment="Center" Text="Proposal" />
                                <TextBlock x:Name="MomentumValue1" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="$72K" />
                            </Grid>
                        </Button>

                        <Button
                            x:Name="MomentumButton2"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Click="OpenOperations_Click"
                            Tag="Adventure Works opportunity">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="MomentumCompany2" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Adventure Works" />
                                    <TextBlock
                                        x:Name="MomentumDetail2"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="New business · Alex Wilber" />
                                </StackPanel>
                                <TextBlock x:Name="MomentumStatus2" Grid.Column="1" VerticalAlignment="Center" Text="Negotiation" />
                                <TextBlock x:Name="MomentumValue2" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="$64K" />
                            </Grid>
                        </Button>

                        <Button
                            x:Name="MomentumButton3"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Click="OpenOperations_Click"
                            Tag="Tailspin Toys renewal">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="MomentumCompany3" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Tailspin Toys" />
                                    <TextBlock
                                        x:Name="MomentumDetail3"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Renewal · Diego Siciliani" />
                                </StackPanel>
                                <TextBlock x:Name="MomentumStatus3" Grid.Column="1" VerticalAlignment="Center" Text="Discovery" />
                                <TextBlock x:Name="MomentumValue3" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="$51K" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>

                <Border
                    x:Name="OpenTicketsPanel"
                    Grid.Column="1"
                    Padding="20"
                    Style="{StaticResource DashboardCardStyle}">
                    <StackPanel Spacing="16">
                        <Grid>
                            <TextBlock
                                AutomationProperties.HeadingLevel="Level2"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="Open tickets" />
                            <Button
                                HorizontalAlignment="Right"
                                Click="OpenOperations_Click"
                                Content="View all tickets"
                                Tag="Open tickets" />
                        </Grid>

                        <StackPanel Spacing="16">
                            <StackPanel x:Name="PendingTicketsGroup" Spacing="8">
                                <TextBlock Style="{StaticResource DashboardSectionLabelStyle}" Text="PENDING" />
                                <ItemsControl
                                    x:Name="PendingTicketsList"
                                    ItemTemplate="{StaticResource DashboardTicketTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel x:Name="InProgressTicketsGroup" Spacing="8">
                                <TextBlock Style="{StaticResource DashboardSectionLabelStyle}" Text="IN PROGRESS" />
                                <ItemsControl
                                    x:Name="InProgressTicketsList"
                                    ItemTemplate="{StaticResource DashboardTicketTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>
                </Border>

            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
