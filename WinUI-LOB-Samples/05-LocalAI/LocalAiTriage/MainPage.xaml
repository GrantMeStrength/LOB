<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LocalAiTriage.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:LocalAiTriage"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:LocalAiTriage.Models"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Support ticket triage" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Summarize and categorize tickets on-device with the local Phi Silica model. No data leaves this PC." />
        </StackPanel>

        <!-- Model availability is persistent context, not a blocking dialog. -->
        <InfoBar
            Grid.Row="1"
            IsClosable="False"
            IsOpen="True"
            Message="{x:Bind ViewModel.AiStatusMessage, Mode=OneWay}"
            Severity="{x:Bind StatusSeverity(ViewModel.IsAiReady), Mode=OneWay}" />

        <!-- Ticket-operation failures have their own retry path. -->
        <InfoBar
            Grid.Row="2"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasOperationError, Mode=OneWay}"
            Message="{x:Bind ViewModel.OperationError, Mode=OneWay}"
            Severity="Error"
            Title="Ticket operation failed">
            <InfoBar.ActionButton>
                <Button
                    AutomationProperties.AutomationId="RetryTicketsButton"
                    Command="{x:Bind ViewModel.InitializeCommand}"
                    Content="Retry" />
            </InfoBar.ActionButton>
        </InfoBar>

        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*" />
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>

            <!--  Ticket list  -->
            <Border
                Grid.Column="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource ControlCornerRadius}">
                <Grid>
                    <!-- Pair the progress indicator with text for a meaningful loading state. -->
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Visibility="{x:Bind local:MainPage.BoolToVisibility(ViewModel.IsLoading), Mode=OneWay}">
                        <ProgressRing
                            Width="36"
                            Height="36"
                            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Loading support tickets…" />
                    </StackPanel>

                    <ItemsView
                        x:Name="TicketsList"
                        AutomationProperties.AutomationId="TicketsList"
                        Padding="8"
                        AutomationProperties.Name="Support tickets"
                        IsItemInvokedEnabled="False"
                        ItemsSource="{x:Bind ViewModel.Tickets, Mode=OneWay}"
                        SelectionChanged="OnTicketSelectionChanged"
                        SelectionMode="Single">
                        <ItemsView.Layout>
                            <StackLayout Spacing="4" />
                        </ItemsView.Layout>
                        <ItemsView.ItemTemplate>
                            <DataTemplate x:DataType="models:SupportTicket">
                                <ItemContainer AutomationProperties.Name="{x:Bind Subject, Mode=OneWay}">
                                    <StackPanel Padding="12" Spacing="2">
                                        <TextBlock
                                            MaxLines="1"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind Subject, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind CustomerName, Mode=OneWay}" />
                                    </StackPanel>
                                </ItemContainer>
                            </DataTemplate>
                        </ItemsView.ItemTemplate>
                    </ItemsView>
                </Grid>
            </Border>

            <!--  Detail + AI triage  -->
            <ScrollViewer Grid.Column="1">
                <Grid>
                    <TextBlock
                        x:Name="EmptyState"
                        x:Load="{x:Bind IsNoTicketSelected(ViewModel.SelectedTicket), Mode=OneWay, FallbackValue=True}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="Select a ticket to view its details and run AI triage." />

                    <!--
                        SelectedTicket is nullable until selection occurs. FallbackValue
                        keeps generated x:Bind code safe during initial activation.
                    -->
                    <StackPanel
                        x:Name="DetailPanel"
                        x:Load="{x:Bind IsTicketSelected(ViewModel.SelectedTicket), Mode=OneWay, FallbackValue=False}"
                        Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.SelectedTicket.Subject, Mode=OneWay, FallbackValue=''}" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}">
                                <Run Text="{x:Bind ViewModel.SelectedTicket.CustomerName, Mode=OneWay, FallbackValue=''}" />
                                <Run Text="&#8226;" />
                                <Run Text="{x:Bind ViewModel.SelectedTicket.Product, Mode=OneWay, FallbackValue=''}" />
                            </TextBlock>
                        </StackPanel>

                        <TextBlock
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.SelectedTicket.Body, Mode=OneWay, FallbackValue=''}"
                            TextWrapping="Wrap" />

                        <Button
                            x:Name="TriageButton"
                            AutomationProperties.AutomationId="TriageButton"
                            AutomationProperties.Name="Run AI triage on the selected ticket"
                            Command="{x:Bind ViewModel.TriageSelectedCommand}"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing
                                    Width="16"
                                    Height="16"
                                    IsActive="{x:Bind ViewModel.SelectedTicket.IsProcessing, Mode=OneWay, FallbackValue=False}" />
                                <TextBlock Text="Triage with local AI" />
                            </StackPanel>
                        </Button>

                        <Border
                            x:Name="TriageResult"
                            x:Load="{x:Bind ViewModel.SelectedTicket.HasTriage, Mode=OneWay, FallbackValue=False}"
                            Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource ControlCornerRadius}">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        FontSize="16"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Glyph="&#xE945;" />
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="AI triage (on-device)" />
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Suggested category" />
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.SelectedTicket.Category, Mode=OneWay, FallbackValue=''}" />
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Summary" />
                                    <TextBlock
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{x:Bind ViewModel.SelectedTicket.Summary, Mode=OneWay, FallbackValue=''}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
