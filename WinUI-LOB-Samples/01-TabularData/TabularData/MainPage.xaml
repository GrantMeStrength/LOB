<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TabularData.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TabularData"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:TabularData.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- Part A: card template rendered by the ItemsView. -->
        <DataTemplate x:Key="CustomerCardTemplate" x:DataType="vm:CustomerViewModel">
            <ItemContainer AutomationProperties.Name="{x:Bind Name}">
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind Name}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind Company}" />
                        <StackPanel
                            Margin="0,8,0,0"
                            Orientation="Horizontal"
                            Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE707;" />
                            <TextBlock Text="{x:Bind Region}" />
                        </StackPanel>
                        <Border
                            Margin="0,8,0,0"
                            Padding="8,2"
                            HorizontalAlignment="Left"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="{StaticResource ControlCornerRadius}">
                            <TextBlock
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Status}" />
                        </Border>
                    </StackPanel>
                </Border>
            </ItemContainer>
        </DataTemplate>

        <DataTemplate x:Key="CustomerRowTemplate" x:DataType="vm:CustomerViewModel">
            <Grid Padding="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Name}" />
                <TextBlock Grid.Column="1" Text="{x:Bind Company}" />
                <TextBlock Grid.Column="2" Text="{x:Bind Region}" />
                <TextBlock Grid.Column="3" Text="{x:Bind Status}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Customers" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="The same 20 records shown as cards and as a columnar table." />
        </StackPanel>

        <Pivot Grid.Row="1">
            <PivotItem Header="Cards">
                <ItemsView
                    x:Name="CardsView"
                    AutomationProperties.AutomationId="CustomerCardsView"
                    IsItemInvokedEnabled="False"
                    ItemsSource="{x:Bind ViewModel.Customers, Mode=OneWay}"
                    ItemTemplate="{StaticResource CustomerCardTemplate}"
                    SelectionMode="None">
                    <ItemsView.Layout>
                        <UniformGridLayout
                            MinColumnSpacing="12"
                            MinItemWidth="260"
                            MinRowSpacing="12" />
                    </ItemsView.Layout>
                </ItemsView>
            </PivotItem>

            <PivotItem Header="Table">
                <StackPanel Spacing="8">
                    <!--
                        The Community Toolkit DataGrid (CommunityToolkit.WinUI.UI.Controls.DataGrid)
                        is unmaintained (~5 years) and is NOT recommended. WinUI has no first-party
                        data grid yet; first-party grid support is in progress. Until then this tab
                        shows a columnar table built from inbox ItemsView/ListView + a DataTemplate.
                        The "Cards" tab (ItemsView) above is the recommended approach.
                    -->
                    <Grid Padding="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Name" />
                        <TextBlock Grid.Column="1" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Company" />
                        <TextBlock Grid.Column="2" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Region" />
                        <TextBlock Grid.Column="3" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Status" />
                    </Grid>

                    <ListView
                        AutomationProperties.AutomationId="CustomerTableListView"
                        IsItemClickEnabled="False"
                        ItemTemplate="{StaticResource CustomerRowTemplate}"
                        ItemsSource="{x:Bind ViewModel.Customers, Mode=OneWay}"
                        SelectionMode="None" />
                </StackPanel>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
