<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TabularData.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TabularData"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:TabularData.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- Part A: card template rendered by the ItemsView. -->
        <DataTemplate x:Key="CustomerCardTemplate" x:DataType="vm:CustomerViewModel">
            <ItemContainer AutomationProperties.Name="{x:Bind Name, Mode=OneWay}">
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind Name, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind Company, Mode=OneWay}" />
                        <StackPanel
                            Margin="0,8,0,0"
                            Orientation="Horizontal"
                            Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE707;" />
                            <TextBlock Text="{x:Bind Region, Mode=OneWay}" />
                        </StackPanel>
                        <Border
                            Margin="0,8,0,0"
                            Padding="8,2"
                            HorizontalAlignment="Left"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="{StaticResource ControlCornerRadius}">
                            <TextBlock
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Status, Mode=OneWay}" />
                        </Border>
                    </StackPanel>
                </Border>
            </ItemContainer>
        </DataTemplate>

        <DataTemplate x:Key="CustomerRowTemplate" x:DataType="vm:CustomerViewModel">
            <Grid Padding="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Name, Mode=OneWay}" />
                <TextBlock Grid.Column="1" Text="{x:Bind Company, Mode=OneWay}" />
                <TextBlock Grid.Column="2" Text="{x:Bind Region, Mode=OneWay}" />
                <TextBlock Grid.Column="3" Text="{x:Bind Status, Mode=OneWay}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Customers" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="The same 20 records shown as cards and as a columnar table." />
        </StackPanel>

        <!--
            LOB users often know the record they need. Update the ViewModel on
            each keystroke so both collection presentations filter together.
        -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox
                AutomationProperties.AutomationId="CustomerSearchBox"
                Header="Search customers"
                PlaceholderText="Name, company, region, or status"
                QueryIcon="Find"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <!-- A zero-result state explains what happened and provides recovery. -->
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Bottom"
                Orientation="Horizontal"
                Spacing="8">
                <ProgressRing
                    Width="16"
                    Height="16"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.ResultSummary, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
        <Pivot Visibility="{x:Bind local:MainPage.InvertBoolToVisibility(ViewModel.IsEmpty), Mode=OneWay}">
            <PivotItem Header="Cards">
                <ItemsView
                    x:Name="CardsView"
                    AutomationProperties.AutomationId="CustomerCardsView"
                    IsItemInvokedEnabled="False"
                    ItemsSource="{x:Bind ViewModel.Customers, Mode=OneWay}"
                    ItemTemplate="{StaticResource CustomerCardTemplate}"
                    SelectionMode="None">
                    <ItemsView.Layout>
                        <UniformGridLayout
                            MinColumnSpacing="12"
                            MinItemWidth="260"
                            MinRowSpacing="12" />
                    </ItemsView.Layout>
                </ItemsView>
            </PivotItem>

            <PivotItem Header="Table">
                <StackPanel Spacing="8">
                    <!-- No first-party WinUI data grid yet, and the Community Toolkit DataGrid is
                         unmaintained, so we don't recommend it. First-party WinUI grid support is
                         in progress; until then this is a stopgap: an inbox ListView with a
                         columnar DataTemplate. Cards (ItemsView) on the other tab is the
                         recommended layout for collections. -->
                    <Grid Padding="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Name" />
                        <TextBlock Grid.Column="1" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Company" />
                        <TextBlock Grid.Column="2" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Region" />
                        <TextBlock Grid.Column="3" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Status" />
                    </Grid>

                    <ListView
                        AutomationProperties.AutomationId="CustomerTableListView"
                        IsItemClickEnabled="False"
                        ItemTemplate="{StaticResource CustomerRowTemplate}"
                        ItemsSource="{x:Bind ViewModel.Customers, Mode=OneWay}"
                        SelectionMode="None" />
                </StackPanel>
            </PivotItem>
        </Pivot>

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="{x:Bind local:MainPage.BoolToVisibility(ViewModel.IsEmpty), Mode=OneWay}">
                <FontIcon
                    FontSize="32"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE721;" />
                <TextBlock
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="No matching customers" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Clear the search or try a broader term." />
                <Button
                    AutomationProperties.AutomationId="ClearCustomerSearchButton"
                    Command="{x:Bind ViewModel.ClearSearchCommand}"
                    Content="Clear search" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
